+/* Reconcile from the main loop, after the driver's completion callback
+ * has finished using the old interface. The latest request wins.
+ */
+static gboolean device_reconcile_power(gpointer user_data)
+{
+	struct connman_device *device = user_data;
+
+	device->power_reconcile = 0;
+	if (!device->driver || device->powered_pending != PENDING_NONE)
+		return FALSE;
+
+	if (device->powered_requested == PENDING_ENABLE)
+		__connman_device_enable(device);
+	else if (device->powered_requested == PENDING_DISABLE)
+		__connman_device_disable(device);
+
+	return FALSE;
+}
+
+static void device_schedule_power(struct connman_device *device)
+{
+	if (!device->driver || device->power_reconcile ||
+			device->powered_requested == PENDING_NONE ||
+			device->powered_pending != PENDING_NONE ||
+			device->powered ==
+			(device->powered_requested == PENDING_ENABLE))
+		return;
+
+	device->power_reconcile = g_idle_add(device_reconcile_power, device);
+}
+
+static void device_cancel_power(struct connman_device *device)
+{
+	clear_pending_trigger(device);
+	if (device->power_reconcile) {
+		g_source_remove(device->power_reconcile);
+		device->power_reconcile = 0;
+	}
+	device->powered_pending = PENDING_NONE;
+	device->powered_requested = PENDING_NONE;
+}
+
 static gboolean device_pending_reset(gpointer user_data)
 {
 	struct connman_device *device = user_data;
 
 	DBG("device %p", device);
 
-	/* Power request timedout, reset power pending state. */
+	/* Do not retry a timed-out operation indefinitely. A later completion
+	 * will still reconcile against powered_requested.
+	 */
 	device->pending_timeout = 0;
 	device->powered_pending = PENDING_NONE;
 
@@ -196,11 +242,8 @@
 	if (!device->driver || !device->driver->enable)
 		return -EOPNOTSUPP;
 
-	/* There is an ongoing power disable request. */
